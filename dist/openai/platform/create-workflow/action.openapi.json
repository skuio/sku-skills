{
  "openapi": "3.1.0",
  "info": {
    "title": "SKU.io — Create a Workflow (automation)",
    "description": "Build, validate, publish, test-run and maintain SKU.io automation workflows from the API — the same node/edge graph the visual Workflow Builder draws. Use this whenever a user wants something to happen automatically in response to something else: email or Slack me when an order lands on a given sales channel, tag or note orders that match a rule, post a webhook to another system, import a supplier feed from FTP on a schedule, or route orders to a warehouse — and when an existing workflow needs changing, pausing, or diagnosing because it did not fire. Starts from a template when one fits, discovers the node catalog and credentials live, and publishes only after a dry run the user has seen — including picking the right moment to fire on, which for an order alert is the channel import rather than the sales-order creation.",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.sku.io",
      "variables": {
        "tenant": {
          "default": "app",
          "description": "Your SKU.io account subdomain."
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/automation/workflow-nodes": {
      "get": {
        "operationId": "list_node_types",
        "summary": "The live catalog of every node type — its category, description, settings (key, type, required, default, apiEndpoint, credentialTypes), outputs (the branch handles) and outputSchema; on newer builds also `preview`/`mutates`, condition `operators`, and a trigger's `availability` on this account. Always read this first; it is the only reliable source for valid `nodes[*].type` values and their `data` keys.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/workflow-nodes/sample-payload": {
      "post": {
        "operationId": "get_sample_payload",
        "summary": "A trigger payload built from the most recent real record that matches the trigger's settings — the right `trigger_payload` for a dry run. Returns `data: null` when nothing on the account matches yet.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "node_type": {
                    "type": "string",
                    "description": "The trigger's `type` from the node catalog.",
                    "example": "channel-order-imported"
                  },
                  "parameters": {
                    "type": "object",
                    "description": "The trigger node's `data`, so the sample respects its filters.",
                    "example": {
                      "salesChannels": [
                        30
                      ]
                    }
                  }
                },
                "required": [
                  "node_type"
                ]
              }
            }
          }
        }
      }
    },
    "/api/automation/lookups/sales-channels": {
      "get": {
        "operationId": "lookup_sales_channels",
        "summary": "Sales channels as {id, name}. The stored value is the numeric id.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/integrations": {
      "get": {
        "operationId": "lookup_integrations",
        "summary": "Connected integrations as {id, name}, where `id` IS the name (e.g. `Shopify`) — the integration order filter matches on the name as text.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/sub-sales-channels": {
      "get": {
        "operationId": "lookup_sub_sales_channels",
        "summary": "Sub sales channels as {id, name}, where `id` is the sub-channel name (e.g. `POS`) and `name` also names its parent channel(s).",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/warehouses": {
      "get": {
        "operationId": "lookup_warehouses",
        "summary": "Warehouses as {id, name}, for warehouse-valued node settings.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/tags": {
      "get": {
        "operationId": "lookup_tags",
        "summary": "Order tags, for the Apply Tags node's `tags` setting.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/airtable-instances": {
      "get": {
        "operationId": "lookup_airtable_instances",
        "summary": "Connected Airtable instances, for the Airtable node.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/lookups/order-filter-fields": {
      "get": {
        "operationId": "lookup_order_filter_fields",
        "summary": "The sales-order fields an order filter may test. The filter is evaluated against this allow-list, so a field not in it never matches.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/workflow-credentials/lookup": {
      "get": {
        "operationId": "lookup_credentials",
        "summary": "Stored credentials as {uuid, name}, filtered by type — the values for a `credential_select` setting's `credentialUuid`.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "One type or a comma-separated list, from the setting's `credentialTypes`.",
            "schema": {
              "type": "string",
              "description": "One type or a comma-separated list, from the setting's `credentialTypes`.",
              "example": "ftp,sftp"
            }
          }
        ]
      }
    },
    "/api/automation/workflow-credentials": {
      "post": {
        "operationId": "create_credential",
        "summary": "Store a credential (secrets encrypted at rest, redacted on read). Only with values the user supplied for this purpose; `google_oauth` cannot be created here — it needs the browser consent flow in the Workflow Builder.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Display name, max 128 chars.",
                    "example": "Supplier SFTP"
                  },
                  "type": {
                    "type": "string",
                    "description": "basic_auth | api_key | bearer_token | ftp | sftp | webhook_token.",
                    "example": "sftp"
                  },
                  "data": {
                    "type": "object",
                    "description": "The type's fields — for ftp/sftp `host`, `port`, `username`, `password` or `privateKey` (+ `passphrase`), `root`."
                  }
                },
                "required": [
                  "name",
                  "type",
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "/api/automation/workflow-templates": {
      "get": {
        "operationId": "list_templates",
        "summary": "Ready-made workflows with their `parameterPrompts` (what must be filled in) and `requiredCredentials`. Check here before assembling a graph by hand.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/automation/workflow-templates/{slug}": {
      "get": {
        "operationId": "get_template",
        "summary": "One template with its prompts and required credentials.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "The template slug.",
            "schema": {
              "type": "string",
              "description": "The template slug.",
              "example": "import-products-ftp-hourly"
            }
          }
        ]
      }
    },
    "/api/automation/workflow-templates/{slug}/instantiate": {
      "post": {
        "operationId": "instantiate_template",
        "summary": "Create a Draft workflow from a template, writing each answered prompt into the graph. A prompt you leave out keeps the template's placeholder, so answer every required one.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "The template slug.",
            "schema": {
              "type": "string",
              "description": "The template slug."
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Workflow name; defaults to the template's."
                  },
                  "parameters": {
                    "type": "object",
                    "description": "Answers keyed by each prompt's `key`, typed as the prompt says.",
                    "example": {
                      "fbaWarehouseId": 3,
                      "threePlWarehouseId": 7
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/automation/workflows": {
      "get": {
        "operationId": "list_workflows",
        "summary": "Paginated list of workflows with run stats. Use it to avoid creating a duplicate, and to find an existing workflow to update.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "filter[status]",
            "in": "query",
            "required": false,
            "description": "draft | published | disabled.",
            "schema": {
              "type": "string",
              "description": "draft | published | disabled.",
              "example": "published"
            }
          },
          {
            "name": "filter[trigger_type]",
            "in": "query",
            "required": false,
            "description": "event | schedule | manual | webhook | pre_dispatch.",
            "schema": {
              "type": "string",
              "description": "event | schedule | manual | webhook | pre_dispatch.",
              "example": "event"
            }
          },
          {
            "name": "filter[search]",
            "in": "query",
            "required": false,
            "description": "Matches name or description.",
            "schema": {
              "type": "string",
              "description": "Matches name or description."
            }
          }
        ]
      },
      "post": {
        "operationId": "create_workflow",
        "summary": "Create a workflow in Draft status from a node/edge graph. The trigger type is derived from the trigger node — you do not set it. Drafts never fire.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Display name, max 128 chars.",
                    "example": "TikTok Shop: email on new order"
                  },
                  "description": {
                    "type": "string",
                    "description": "What it does and why it exists. Worth writing — it is what the next person reads before deciding whether to disable it."
                  },
                  "category": {
                    "type": "string",
                    "description": "Free-text grouping, max 50 chars (e.g. orders, imports, inventory).",
                    "example": "orders"
                  },
                  "nodes": {
                    "type": "array",
                    "description": "One object per node: `id` (string, max 64, unique in the graph), `type` (a `type` from the node catalog), `position` {x, y} (numeric — the canvas coordinates the builder will draw it at), `data` (object — the node's settings, keyed by the `settings[*].key` the catalog lists; required even when empty), optional `label`.",
                    "example": [
                      {
                        "id": "trigger-1",
                        "type": "sales-order-created",
                        "position": {
                          "x": 80,
                          "y": 200
                        },
                        "data": {
                          "salesChannels": [
                            30
                          ],
                          "orderStatuses": [
                            "*"
                          ]
                        },
                        "label": "Order created"
                      }
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "description": "One object per connection: `id`, `source` (node id), `target` (node id); optional `sourceHandle` (required to leave a branching node — `true`/`false` on IF, `case0…`/`fallback` on Switch), `targetHandle`, `label`, `branchLabel`.",
                    "example": [
                      {
                        "id": "e1",
                        "source": "trigger-1",
                        "target": "node-2"
                      }
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "viewport": {
                    "type": "object",
                    "description": "Canvas position {x, y, zoom} the builder opens at. Defaults are fine."
                  },
                  "preview_mode": {
                    "type": "boolean",
                    "description": "When true, every run executes triggers, conditions and lookups for real but SKIPS every state-changing Action/Integration step (emails, Slack, webhooks, order and inventory writes), recording what each would have done. Default false.",
                    "example": true
                  }
                },
                "required": [
                  "name",
                  "nodes",
                  "edges"
                ]
              }
            }
          }
        }
      }
    },
    "/api/automation/workflows/validate": {
      "post": {
        "operationId": "validate_workflow",
        "summary": "Check a graph without saving. Verifies exactly one trigger node, that every edge references existing nodes, and that every non-trigger node has an incoming connection. Call this before create and before update — it is free and catches the structural mistakes.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "description": "The node list, same shape as on create.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "description": "The edge list, same shape as on create.",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "nodes",
                  "edges"
                ]
              }
            }
          }
        }
      }
    },
    "/api/automation/workflows/{workflow}": {
      "get": {
        "operationId": "get_workflow",
        "summary": "One workflow with its full graph, derived triggerType/triggerConfig, and publish state.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      },
      "put": {
        "operationId": "update_workflow",
        "summary": "Update name, description, category, graph, settings or preview_mode. All fields optional. Submitting `nodes` re-derives the trigger type and trigger config, so send the WHOLE graph — a partial node list silently drops the nodes you left out.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "description": "The complete node list. Omit the key entirely to leave the graph untouched.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "description": "The complete edge list.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "preview_mode": {
                    "type": "boolean",
                    "description": "Toggle preview (dry-run) mode on an existing workflow."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_workflow",
        "summary": "Permanently delete a workflow. Irreversible, and it takes the run history with it — disable instead unless the user explicitly asked to delete.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/automation/workflows/{workflow}/publish": {
      "post": {
        "operationId": "publish_workflow",
        "summary": "Validate then publish, making the trigger live. On validation failure nothing changes and the errors come back as 422. On success the version increments and publishedAt is set. A workflow only ever fires once published.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/automation/workflows/{workflow}/toggle": {
      "post": {
        "operationId": "toggle_workflow",
        "summary": "Flip between published (live) and disabled (paused). Only those two states can be toggled — a draft must be published first. This is the off switch; prefer it to delete.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/automation/workflows/{workflow}/execute": {
      "post": {
        "operationId": "execute_workflow",
        "summary": "Run a published workflow by hand against a payload you supply, instead of waiting for a real trigger. Queued asynchronously — the response is the execution record at status `pending`; poll get-execution for the result.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trigger_payload": {
                    "type": "object",
                    "description": "The data the trigger node would have emitted, shaped like that trigger's `outputSchema`. Omit it and event triggers fall back to sample data built from the most recent matching record."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/automation/workflows/{workflow}/executions": {
      "get": {
        "operationId": "list_executions",
        "summary": "Run history for one workflow — status, duration, trigger reference, error.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      }
    },
    "/api/automation/workflow-executions/{execution}": {
      "get": {
        "operationId": "get_execution",
        "summary": "One execution with its per-step results — each step's status, logs, and (in preview mode) the input the skipped step would have used. This is where you read what actually happened.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "execution",
            "in": "path",
            "required": true,
            "description": "The execution id.",
            "schema": {
              "type": "integer",
              "description": "The execution id."
            }
          }
        ]
      }
    },
    "/api/automation/workflows/{workflow}/clone": {
      "post": {
        "operationId": "clone_workflow",
        "summary": "Duplicate a workflow as a new Draft named \"<name> (Copy)\". Use it to change a live workflow safely — clone, edit the clone, test it, then swap.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "workflow",
            "in": "path",
            "required": true,
            "description": "The workflow id.",
            "schema": {
              "type": "integer",
              "description": "The workflow id."
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "SKU.io Personal Access Token."
      }
    }
  }
}
