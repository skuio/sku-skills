{
  "openapi": "3.1.0",
  "info": {
    "title": "SKU.io — Reconcile a Supplier Statement",
    "description": "Reconcile a supplier's statement and the bank payments to them against SKU.io's bills, credits and payments, explain every difference, and fix the SKU.io side with approval. Use for \"does our statement from X match\", \"why does SKU.io say we owe X more\", or a regular supplier reconciliation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.sku.io",
      "variables": {
        "tenant": {
          "default": "app",
          "description": "Your SKU.io account subdomain."
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/suppliers": {
      "get": {
        "operationId": "find_supplier",
        "summary": "Resolve the supplier named on the statement to its id. (A bare GET /api/suppliers 405s.)",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "filter[search]",
            "in": "query",
            "required": false,
            "description": "Supplier name or email from the statement.",
            "schema": {
              "type": "string",
              "description": "Supplier name or email from the statement.",
              "example": "Acme Batteries"
            }
          }
        ]
      }
    },
    "/api/suppliers/{supplier}/statement": {
      "get": {
        "operationId": "get_supplier_statement",
        "summary": "SKU.io's own statement for the supplier, in tenant currency. view=open_item (default) gives open_items[] (doc_type, id, number, supplier_invoice_number, purchase_order, date, due_date, total, total_paid, credits_applied, deposits_applied, outstanding_balance, status), credits[] (open, unapplied credits with `available`), deposits[] and totals{open, credits, deposits, net_payable}. view=activity gives opening/closing balance and lines[] (date, type, reference, debit, credit, running_balance; type invoice | bill | payment | credit_applied | credit_unapplied | deposit_applied | deposit_unapplied) for a date range.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "supplier",
            "in": "path",
            "required": true,
            "description": "Supplier id.",
            "schema": {
              "type": "integer",
              "description": "Supplier id."
            }
          },
          {
            "name": "view",
            "in": "query",
            "required": false,
            "description": "open_item (default) or activity.",
            "schema": {
              "type": "string",
              "description": "open_item (default) or activity.",
              "example": "open_item"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "ISO date. Required when view=activity.",
            "schema": {
              "type": "string",
              "description": "ISO date. Required when view=activity."
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "ISO date, on or after date_from. Required when view=activity.",
            "schema": {
              "type": "string",
              "description": "ISO date, on or after date_from. Required when view=activity."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices": {
      "get": {
        "operationId": "list_purchase_invoices",
        "summary": "Every bill for the supplier, paid ones included (the statement only lists open ones). Rows carry supplier_invoice_number, purchase_invoice_date, calculated_total + tax_total (the gross total; there is no single total field), total_paid, outstanding_balance, status, payments[] and applied_vendor_credits[] (each with its allocation id and vendor_credit number).",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "filter[supplier_id]",
            "in": "query",
            "required": false,
            "description": "Supplier id. Always send it.",
            "schema": {
              "type": "string",
              "description": "Supplier id. Always send it."
            }
          },
          {
            "name": "filter[status]",
            "in": "query",
            "required": false,
            "description": "unpaid, partially_paid or paid. Omit for all.",
            "schema": {
              "type": "string",
              "description": "unpaid, partially_paid or paid. Omit for all."
            }
          },
          {
            "name": "filter[purchase_invoice_date.after]",
            "in": "query",
            "required": false,
            "description": "ISO date, to bound the window.",
            "schema": {
              "type": "string",
              "description": "ISO date, to bound the window."
            }
          },
          {
            "name": "filter[search]",
            "in": "query",
            "required": false,
            "description": "Supplier invoice number, PO number or total. Pair with search_columns=supplier_invoice_number for an exact number lookup.",
            "schema": {
              "type": "string",
              "description": "Supplier invoice number, PO number or total. Pair with search_columns=supplier_invoice_number for an exact number lookup."
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "purchase_invoice_date for oldest first.",
            "schema": {
              "type": "string",
              "description": "purchase_invoice_date for oldest first.",
              "example": "purchase_invoice_date"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "description": "Page size."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices/{purchaseInvoice}": {
      "get": {
        "operationId": "get_purchase_invoice",
        "summary": "One bill with its lines, payments and applied credits, to compare with the supplier's invoice line by line.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "purchaseInvoice",
            "in": "path",
            "required": true,
            "description": "Purchase invoice id (not the supplier's invoice number).",
            "schema": {
              "type": "integer",
              "description": "Purchase invoice id (not the supplier's invoice number)."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices/{purchaseInvoiceId}/payments": {
      "get": {
        "operationId": "list_invoice_payments",
        "summary": "Payments recorded on one bill: id, amount, payment_date, payment_type, external_reference. An external_reference with a provider prefix (xero:…, qbo:…) means the payment was imported from the accounting system rather than recorded in SKU.io.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "purchaseInvoiceId",
            "in": "path",
            "required": true,
            "description": "Purchase invoice id.",
            "schema": {
              "type": "integer",
              "description": "Purchase invoice id."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices/{purchaseInvoiceId}/payments/{payment}": {
      "delete": {
        "operationId": "delete_invoice_payment",
        "summary": "Remove one payment from a bill. Only for a proven duplicate; see the guardrails.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "purchaseInvoiceId",
            "in": "path",
            "required": true,
            "description": "Purchase invoice id.",
            "schema": {
              "type": "integer",
              "description": "Purchase invoice id."
            }
          },
          {
            "name": "payment",
            "in": "path",
            "required": true,
            "description": "Payment id (from list-invoice-payments).",
            "schema": {
              "type": "integer",
              "description": "Payment id (from list-invoice-payments)."
            }
          }
        ]
      }
    },
    "/api/vendor-credits/for-supplier/{supplier}": {
      "get": {
        "operationId": "list_supplier_credits",
        "summary": "The supplier's OPEN vendor credits only (remaining amount above zero). A fully applied credit is not listed; find those through each bill's applied_vendor_credits[].",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "supplier",
            "in": "path",
            "required": true,
            "description": "Supplier id.",
            "schema": {
              "type": "integer",
              "description": "Supplier id."
            }
          }
        ]
      }
    },
    "/api/vendor-credits/{vendor_credit}/allocations/{vendor_credit_allocation}": {
      "delete": {
        "operationId": "unapply_vendor_credit",
        "summary": "Take a credit back off a bill. Reopens the credit, raises the bill's outstanding balance, and shows as credit_unapplied on the activity statement. The allocation id is applied_vendor_credits[].id on the bill.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "vendor_credit",
            "in": "path",
            "required": true,
            "description": "Vendor credit id.",
            "schema": {
              "type": "integer",
              "description": "Vendor credit id."
            }
          },
          {
            "name": "vendor_credit_allocation",
            "in": "path",
            "required": true,
            "description": "Allocation id.",
            "schema": {
              "type": "integer",
              "description": "Allocation id."
            }
          }
        ]
      }
    },
    "/api/vendor-credits/allocate-batch": {
      "post": {
        "operationId": "apply_credits_to_bill",
        "summary": "Apply one or more open credits to one bill in a single all-or-nothing call.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "purchase_invoice_id": {
                    "type": "integer",
                    "description": "The bill the credits reduce."
                  },
                  "allocations": {
                    "type": "array",
                    "description": "Each { vendor_credit_id, amount (min 0.01) }.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "allocated_at": {
                    "type": "string",
                    "description": "ISO date the credit was used, normally the payment date."
                  },
                  "notes": {
                    "type": "string",
                    "description": "Why (max 1000 chars), e.g. the bank reference of the payment that used it."
                  }
                },
                "required": [
                  "purchase_invoice_id",
                  "allocations"
                ]
              }
            }
          }
        }
      }
    },
    "/api/accounting/sync-settings": {
      "get": {
        "operationId": "get_sync_settings",
        "summary": "Which transaction types sync to the accounting system automatically. sync_controls_by_type.purchase_order_invoice.enabled false means bills stay in SKU.io until someone posts them (find-ledger-entry → force-sync-entry).",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/accounting/sync-settings/connection": {
      "get": {
        "operationId": "get_sync_connection",
        "summary": "Whether the accounting connection is active at all (sync_status, is_connection_active, blocker). Inactive means nothing can be posted; stop and report it.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/ledger/entries/by-source": {
      "get": {
        "operationId": "find_ledger_entry",
        "summary": "The bill's current ledger entry: id, status, display_status{key, label, reason} (excluded | pending_sync | syncing | synced | failed | needs_attention | …), can_sync_now, sync_override, provider_link. display_status.key \"synced\" means the bill is in the accounting system.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "source_type",
            "in": "query",
            "required": true,
            "description": "The document's model class.",
            "schema": {
              "type": "string",
              "description": "The document's model class.",
              "example": "App\\Models\\PurchaseInvoice"
            }
          },
          {
            "name": "source_id",
            "in": "query",
            "required": true,
            "description": "The purchase invoice id.",
            "schema": {
              "type": "integer",
              "description": "The purchase invoice id."
            }
          }
        ]
      }
    },
    "/api/ledger/entries/{entry}/sync-inspection": {
      "get": {
        "operationId": "inspect_entry_sync",
        "summary": "Why an entry is not syncing: eligible, enableable (blocked only by a setting or an override, so force-sync-entry will post it), reasons[] and structural_reasons[] (blocked for a reason an override cannot lift).",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "entry",
            "in": "path",
            "required": true,
            "description": "Ledger entry id (from find-ledger-entry).",
            "schema": {
              "type": "integer",
              "description": "Ledger entry id (from find-ledger-entry)."
            }
          }
        ]
      }
    },
    "/api/ledger/entries/{entry}/sync-override": {
      "post": {
        "operationId": "force_sync_entry",
        "summary": "Post this one document past a per-type auto-sync opt-out. override \"force_enabled\" marks it to sync and queues the push; null removes the override. Needs the user's accounting.sync permission.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "entry",
            "in": "path",
            "required": true,
            "description": "Ledger entry id.",
            "schema": {
              "type": "integer",
              "description": "Ledger entry id."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "override": {
                    "type": "string",
                    "description": "force_enabled (or null to clear).",
                    "example": "force_enabled"
                  }
                },
                "required": [
                  "override"
                ]
              }
            }
          }
        }
      }
    },
    "/api/ledger/entries/{entry}/sync": {
      "post": {
        "operationId": "sync_entry_now",
        "summary": "Push an eligible entry now rather than waiting for the queue. The message says whether it was queued, not eligible, locked, or rejected by the provider.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "entry",
            "in": "path",
            "required": true,
            "description": "Ledger entry id.",
            "schema": {
              "type": "integer",
              "description": "Ledger entry id."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices/supplier-payments/allocation-suggestion": {
      "get": {
        "operationId": "suggest_payment_allocation",
        "summary": "The supplier's open bills oldest-due first, with `total` spread across them greedily. A starting point only; it is not how the supplier applied the money.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "supplier_id",
            "in": "query",
            "required": true,
            "description": "Supplier id.",
            "schema": {
              "type": "integer",
              "description": "Supplier id."
            }
          },
          {
            "name": "total",
            "in": "query",
            "required": false,
            "description": "The payment amount to spread.",
            "schema": {
              "type": "number",
              "description": "The payment amount to spread."
            }
          }
        ]
      }
    },
    "/api/purchase-invoices/supplier-payments": {
      "get": {
        "operationId": "list_supplier_payments",
        "summary": "Supplier payments recorded in SKU.io (one payment across several bills), newest first.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "filter[supplier_id]",
            "in": "query",
            "required": false,
            "description": "Supplier id.",
            "schema": {
              "type": "string",
              "description": "Supplier id."
            }
          }
        ]
      },
      "post": {
        "operationId": "record_supplier_payment",
        "summary": "Record money that already left the bank as one payment across one or more bills. Credits cannot be part of it: apply them to the bills first, then pay the net. Each allocation must not exceed the bill's outstanding balance; all bills must share a currency.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "supplier_id": {
                    "type": "integer",
                    "description": "Supplier id."
                  },
                  "payment_date": {
                    "type": "string",
                    "description": "The date the bank line cleared, ISO."
                  },
                  "payment_type_id": {
                    "type": "integer",
                    "description": "From list-payment-types. Omitted, it falls back to \"Cash\"."
                  },
                  "external_reference": {
                    "type": "string",
                    "description": "The bank line's own reference (ACH/wire number), so the payment can be traced."
                  },
                  "allocations": {
                    "type": "array",
                    "description": "Each { purchase_invoice_id, amount } (or bill_id for a non-PO bill).",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "supplier_id",
                  "payment_date",
                  "allocations"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v2/payment-types": {
      "get": {
        "operationId": "list_payment_types",
        "summary": "Resolve payment_type_id by name (e.g. \"Bank Transfer\", \"ACH\"). Don't invent the id.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/purchase-invoices/supplier-payments/{supplierPaymentId}": {
      "delete": {
        "operationId": "delete_supplier_payment",
        "summary": "Reverse a supplier payment recorded in SKU.io (and its accounting-system batch, if it was pushed).",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "parameters": [
          {
            "name": "supplierPaymentId",
            "in": "path",
            "required": true,
            "description": "Supplier payment id.",
            "schema": {
              "type": "integer",
              "description": "Supplier payment id."
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "SKU.io Personal Access Token."
      }
    }
  }
}
